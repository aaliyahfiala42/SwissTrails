        <!-- Parameters -->
        <section class="how-section">
            <div class="section-heading">
                <span class="eyebrow">Parameters</span>
                <h2>What the controls mean</h2>
            </div>

            <div class="parameter-list">
                <div>
                    <strong>m: number of ants</strong>
                    <p>More ants means more route attempts per iteration.</p>
                </div>

                <div>
                    <strong>n: number of trail points</strong>
                    <p>The number of points that the route must visit.</p>
                </div>

                <div>
                    <strong>NC: number of iterations</strong>
                    <p>How many times the colony repeats the route-building process.</p>
                </div>
                <div>
                    <strong>ρ: evaporation rate</strong>
                    <p>Controls how much pheromone remains after each iteration.</p>
                </div>

                <div>
                    <strong>Q: pheromone deposit strength</strong>
                    <p>Controls how much pheromone ants add after completing a route.</p>
                </div>


                <div>
                    <strong>α: pheromone influence</strong>
                    <p>Controls how strongly ants follow existing pheromone trails.</p>
                </div>

                <div>
                    <strong>β: distance influence</strong>
                    <p>Controls how strongly ants prefer closer trail points.</p>
                </div>


            </div>
        </section>



