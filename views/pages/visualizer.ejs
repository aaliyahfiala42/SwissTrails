<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="page">
<aside class="sidebar">
    <h1>Swiss Trails</h1>
    <p><%= trails.length %> trail points</p>

    <ul class="trail-list">
    <% trails.forEach((trail, index) => { %>
        <li
        class="trail-item"
        data-index="<%= index %>"
        >
        <strong><%= trail.trail_name %></strong>
        <div class="coords">
            <%= trail.latitude %>, <%= trail.longitude %>
        </div>
        </li>
    <% }) %>
    </ul>
</aside>

    <div id="map"></div>


<div class="parameters">
    <div class="chart-card">
    <div class="chart-header">
        <h3>Convergence Chart</h3>
    </div>

    <div class="chart-wrap">
        <span class="y-axis-label">Best path distance (km)</span>

        <div class="chart-main">
            <canvas id="convergenceCanvas"></canvas>
            <span class="x-axis-label">Iteration</span>
        </div>
    </div>
    
</div>
<div class="metrics">
    <div>Iteration: <strong id="iterationMetric">0</strong></div>
    <div>Best path distance: <strong id="costMetric">-</strong> km</div>
</div>

<h2>Parameters</h2>
<label>Number of ants (m): <input id="antsInput" type="number"  value="30" min="1" max="100"></label>
<label>Number of iterations (NC): <input id="iterationsInput" type="number" value="30" min="1" max="500"></label>
<label>Number of trails (n): <input id="trailsInput" type="number" value="30" min="1" max="359"></label>

<label>Pheromone deposit strength (Q): <input id="pheromoneInput" type="number" value="100" min="1" max="1000" step="1"></label>
<label>Evaporation rate (ρ): <input id="evaporationInput" type="number" value="0.5" min="0" max="1" step="0.01"></label>
<label>Pheromone influence (α): <input id="alphaInput" type="number" value="1" min="0" max="10" step="0.1"></label>
<label>Distance influence (ß): <input id="betaInput" type="number" value="5" min="1" max="10" step="0.1"></label>

<div>
<button id="startACOBtn">Start</button>
<button id="resetACOBtn">Reset</button>
</div>





</div>


</div>

<!-- Leaflet JS -->
<script
src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
crossorigin=""
></script>
<script>
    window.trails = <%- JSON.stringify(trails) %>;
</script>

<script src="/js/aco.js"></script>

<%- include('../partials/footer') %>
